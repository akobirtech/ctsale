# ============================================================
#  CT Sale — MUHIT NAMUNASI (.env.example)
# ============================================================

DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=
JWT_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1

SITE_NAME=CT Sale
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/ctsale

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# --- Celery / Redis ---
# Redis o'rnatilmagan bo'lsa CELERY_TASK_ALWAYS_EAGER=True qoldiring:
# vazifalar sinxron bajariladi, sayt to'liq ishlayveradi.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
USE_REDIS_CACHE=False

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
# Bo'sh qoldirilsa botning o'zidan (getMe) aniqlanadi
TELEGRAM_BOT_USERNAME=
TELEGRAM_MOCK=False

# --- Media limitlari ---
MAX_IMAGES_PER_PRODUCT=10
MAX_VIDEOS_PER_PRODUCT=2
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# --- Biznes ---
PRODUCT_EXPIRY_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Email (dev: konsolga chiqadi) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CT Sale <noreply@ctsale.uz>

# --- SEO ---
SEO_ALLOW_INDEXING=True
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_VERIFICATION=
SITEMAP_PAGE_SIZE=5000
CSP_REPORT_ONLY=False
